# Copy to .env and fill in. Never commit the real .env file.

PROXY_HOST=proxy.fidobox.us
PROXY_HTTP_PORT=10000
PROXY_SOCKS_PORT=10001
PROXY_USER=your-proxy-username
PROXY_PASS=your-proxy-password

# Password required to view the dashboard / call the API. Leave blank to
# disable auth entirely (not recommended once the Tailscale Funnel URL is
# public).
PAGE_PASSWORD=change-me

# Optional tuning (defaults shown):
# PORT=8787
# CHECK_INTERVAL_SEC=15
# HISTORY_DAYS=7
